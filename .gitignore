# ==========================================
# PROPIQ AI - Root .gitignore
# ==========================================

# 1. Environment Variables & Secrets (CRITICAL)
.env
.env.*
*.env
secrets.json
kaggle.json
client_secret.json
credentials.json
*.pem
*.key
*.cert

# 2. Node.js & Frontend (React/Vite)
frontend/node_modules/
frontend/dist/
frontend/build/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# 3. Python & Backend (FastAPI)
__pycache__/
*.py[cod]
*$py.class
backend/env/
backend/venv/
backend/.venv/
env/
venv/
.venv/

# 4. Databases & Storage
*.db
*.sqlite3
backend/storage/

# 5. Data & Machine Learning (Large Files)
data/
backend/ml/models/
*.pkl
*.onnx
*.pt
*.joblib

# 6. Testing & Coverage
.pytest_cache/
pytest-cache-files-*
.coverage
htmlcov/
coverage.xml

# 7. OS & IDEs
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp

# 8. Temporary Files
tmp/
.tmp/
temp/